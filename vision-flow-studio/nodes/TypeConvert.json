{
  "type_id": "TypeConvert",
  "display_name": "类型转换",
  "category": "工具",
  "icon": "icons/convert.svg",
  "algo_binding": { "dll": "vision_algo", "algo_name": "TypeConvert" },
  "inputs": [
    { "name": "value", "type": "Any", "required": true, "description": "待转换的输入数据（任意类型）" }
