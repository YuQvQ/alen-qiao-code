{
  "type_id": "DistanceTransform",
  "display_name": "距离变换",
  "category": "分析",
  "algo_binding": { "dll": "vision_algo", "algo_name": "DistanceTransform" },
  "inputs": [{ "name": "image", "type": "Image", "required": true, "description": "输入二值/灰度图" }],
