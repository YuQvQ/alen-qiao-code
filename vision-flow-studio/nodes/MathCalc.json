  ],
  "outputs": [
    { "name": "value", "type": "Double", "required": true, "description": "a op b 的结果" }
  ],
  "parameters": [
    { "name": "op", "type": "Enum", "default": "+", "options": [ [ "+", "加(+)" ], [ "-", "减(-)" ], [ "*", "乘(*)" ], [ "/", "除(/)" ], [ "%", "取余(%)" ] ], "description": "运算符" }
  ]
}
