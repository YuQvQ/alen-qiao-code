{
  "type_id": "MathCalc",
  "display_name": "四则运算",
  "category": "工具",
  "icon": "icons/convert.svg",
  "algo_binding": { "dll": "", "algo_name": "MathCalc" },
  "inputs": [
    { "name": "a", "type": "Double", "required": false, "description": "操作数a" },
