{
  "type_id": "ImageFlip",
  "display_name": "图像翻转",
  "category": "几何",
  "algo_binding": { "dll": "vision_algo", "algo_name": "ImageFlip" },
  "inputs": [{ "name": "image", "type": "Image", "required": true, "description": "输入图像" }],
