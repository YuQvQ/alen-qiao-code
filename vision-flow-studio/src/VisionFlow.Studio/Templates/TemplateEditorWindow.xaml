<Window x:Class="VisionFlow.Studio.Templates.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模板编辑器" Width="1100" Height="750"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3a3a3a"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="ToolBtn">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button" x:Key="ToolBtnActive">
            <Setter Property="Background" Value="#0a84ff"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0a84ff"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#0a84ff"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="#252525" Padding="8" BorderBrush="#3a3a3a" BorderThickness="0,0,0,1">
            <StackPanel>
                <!-- 第一行：预处理 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="图像模式：" Margin="0,0,4,0"/>
                    <ComboBox x:Name="ModeCombo" Width="120" SelectedIndex="0" SelectionChanged="OnModeChanged">
                        <ComboBoxItem Content="原图"/>
                        <ComboBoxItem Content="灰度图"/>
                        <ComboBoxItem Content="二值图"/>
                    </ComboBox>
                    <TextBlock x:Name="ThreshLabel" Text="阈值：128" Margin="12,0,4,0" Visibility="Collapsed"/>
                    <Slider x:Name="ThreshSlider" Width="140" Minimum="0" Maximum="255" Value="128"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            Visibility="Collapsed" ValueChanged="OnThreshChanged"/>
                    <TextBlock Text="缩放：" Margin="16,0,4,0"/>
                    <Slider x:Name="ZoomSlider" Width="120" Minimum="0.1" Maximum="5" Value="1"
                            TickFrequency="0.1" IsSnapToTickEnabled="False" ValueChanged="OnZoomChanged"/>
                    <TextBlock x:Name="ZoomLabel" Text="100%" Margin="4,0,0,0" Width="48"/>
                </StackPanel>
                <!-- 第二行：绘制工具 -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="工具：" Margin="0,0,4,0"/>
                    <Button x:Name="BtnRoi" Content="ROI矩形" Style="{StaticResource ToolBtnActive}" Click="OnToolRoi"/>
                    <Button x:Name="BtnRectMask" Content="矩形掩膜" Style="{StaticResource ToolBtn}" Click="OnToolRectMask"/>
                    <Button x:Name="BtnCircleMask" Content="圆形掩膜" Style="{StaticResource ToolBtn}" Click="OnToolCircleMask"/>
                    <Button x:Name="BtnBrush" Content="画笔掩膜" Style="{StaticResource ToolBtn}" Click="OnToolBrush"/>
                    <Button x:Name="BtnEraser" Content="橡皮" Style="{StaticResource ToolBtn}" Click="OnToolEraser"/>
                    <Button x:Name="BtnClearMask" Content="清除掩膜" Style="{StaticResource ToolBtn}" Click="OnClearMask"/>
                    <Button x:Name="BtnClearAll" Content="全部清除" Style="{StaticResource ToolBtn}" Click="OnClearAll"/>
                    <TextBlock x:Name="InfoText" Text="请拖动绘制模板 ROI 矩形" Margin="16,0,0,0" Foreground="#888"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 中间图像区域 -->
        <Border Grid.Row="1" Background="#0a0a0a">
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="ImageHost" ClipToBounds="True">
                    <Image x:Name="ImgDisplay" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <Canvas x:Name="Overlay" Background="Transparent"
                            MouseLeftButtonDown="OnCanvasMouseDown"
                            MouseMove="OnCanvasMouseMove"
                            MouseLeftButtonUp="OnCanvasMouseUp"
                            MouseLeave="OnCanvasMouseLeave"/>
                    <Image x:Name="MaskOverlay" Opacity="0.4" IsHitTestVisible="False"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="#252525" Padding="8" BorderBrush="#3a3a3a" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="RoiInfo" Text="" Margin="0,0,16,0" Foreground="#888"/>
                <Button Content="取消" Click="OnCancel" Width="80"/>
                <Button Content="确定" Click="OnConfirm" Width="80" Background="#0a84ff" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>