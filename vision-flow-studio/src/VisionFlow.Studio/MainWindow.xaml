<Window x:Class="VisionFlow.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VisionFlow.Studio.Controls"
        xmlns:execution="clr-namespace:VisionFlow.Studio.Execution"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VisionFlow Studio" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceMutedBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <DockPanel>
        <!-- ============================================================
             顶部工具栏
             ============================================================ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource BrandBrush}"
                            Margin="0,0,8,0">
                        <TextBlock Text="◈" Foreground="White" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="VisionFlow" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource BrandBrush}" />
                    <TextBlock Text=" Studio" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource TextMainBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Button x:Name="BtnNew"    Content="新建"   Padding="12,4" Margin="2,0" Click="BtnNew_Click" />
                    <Button x:Name="BtnOpen"   Content="打开"   Padding="12,4" Margin="2,0"
                            Click="BtnOpen_Click" />
                    <Button x:Name="BtnSave"   Content="保存"   Padding="12,4" Margin="2,0"
                            Click="BtnSave_Click" />
                    <Rectangle Width="1" Height="20" Fill="{StaticResource BorderBrush}" Margin="8,0" />
                    <Button x:Name="BtnRun"    Content="▶ 连续运行"  Style="{StaticResource PrimaryButton}" Padding="14,5" Margin="2,0"
                            Click="BtnRun_Click" />
                    <Button x:Name="BtnRunOnce" Content="▶ 运行一次"  Padding="14,5" Margin="2,0"
                            Click="BtnRunOnce_Click" />
                    <Button x:Name="BtnStop"   Content="■ 停止"  Padding="14,4" Margin="2,0" IsEnabled="False"
                            Click="BtnStop_Click" />
                    <Rectangle Width="1" Height="20" Fill="{StaticResource BorderBrush}" Margin="8,0" />
                    <Button x:Name="BtnFit"    Content="⤢ 适应" Padding="12,4" Margin="2,0" Click="BtnFit_Click" />
                    <Button x:Name="BtnActual" Content="1:1"   Padding="12,4" Margin="2,0" Click="BtnActual_Click" />
                </StackPanel>

                <TextBlock Grid.Column="2" x:Name="StatusText" Text="就绪"
                           VerticalAlignment="Center" Margin="14,0"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
            </Grid>
        </Border>

        <!-- ============================================================
             底部日志面板
             ============================================================ -->
        <Border DockPanel.Dock="Bottom" Height="140"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceMutedBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,4">
                    <DockPanel>
                        <TextBlock Text="日志" FontWeight="SemiBold" FontSize="12"
                                   VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <TextBlock x:Name="LogCountText" Text="0 条"
                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            <Button x:Name="BtnClearLog" Content="清空" Padding="8,2"
                                    Margin="0,0,4,0" Click="BtnClearLog_Click" />
                            <CheckBox x:Name="AutoScrollCheck" Content="自动滚动"
                                      IsChecked="True" VerticalAlignment="Center"
                                      Margin="8,0,0,0" FontSize="11" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ListBox x:Name="LogList" BorderThickness="0" Background="#FAFAFA"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemsSource="{Binding Entries, Source={x:Static execution:Logger.Instance}}"
                         FontFamily="Consolas, Cascadia Mono, monospace" FontSize="11">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type execution:LogEntry}">
                            <TextBlock Text="{Binding DisplayText}"
                                       Foreground="{Binding LevelBrush}"
                                       TextOptions.TextFormattingMode="Display" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================================================
             中间区域：Grid 三列布局
             列0=节点库(200px)  列1=画布(占剩余一半)  列2=图像窗口(占剩余一半)
             图像窗口始终占 UI 的一半
             ============================================================ -->
        <Grid Background="{StaticResource SurfaceMutedBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 列0：节点库 -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="节点库" Style="{StaticResource HeaderLabel}"
                               Margin="14,12,14,8" />
                    <TextBox x:Name="NodeSearchBox" DockPanel.Dock="Top"
                             Margin="10,0,10,6" Padding="6,3"
                             TextChanged="NodeSearchBox_TextChanged"
                             ToolTip="输入关键字过滤节点（名称/分类）" />
                    <ListBox x:Name="NodeLibraryList"
                             BorderThickness="0" Background="Transparent"
                             Padding="6,0,6,8"
                             SelectionMode="Single"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseLeftButtonDown="NodeLibraryList_PreviewMouseLeftButtonDown">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <Expander IsExpanded="True" Margin="2,4,2,0"
                                                              BorderBrush="{StaticResource BorderBrush}"
                                                              BorderThickness="0,0,0,1">
                                                        <Expander.Header>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold" FontSize="12"
                                                                       Foreground="{StaticResource TextMainBrush}" />
                                                        </Expander.Header>
                                                        <ItemsPresenter Margin="0,2"/>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemBorder" Padding="8,6" CornerRadius="5"
                                        Background="Transparent" Margin="0,1">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="4" CornerRadius="2"
                                                Background="{Binding CategoryBrush}"
                                                Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                   FontSize="13" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#F5F3FF" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 列1：画布 -->
            <controls:NodeCanvas Grid.Column="1" x:Name="CanvasHost" ClipToBounds="True" />

            <!-- 列2：图像查看窗口（始终占 UI 的一半） -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <controls:ImageWindow x:Name="ImageHost" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
