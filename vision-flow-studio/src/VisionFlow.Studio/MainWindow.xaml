<Window x:Class="VisionFlow.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VisionFlow.Studio.Controls"
        xmlns:execution="clr-namespace:VisionFlow.Studio.Execution"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VisionFlow Studio" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceMutedBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <DockPanel>
        <!-- ============================================================
             顶部工具栏
             ============================================================ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Height="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 品牌区 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BrandBrush}"
                            Margin="0,0,10,0">
                        <TextBlock Text="◈" Foreground="White" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="VisionFlow" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Studio" FontWeight="Bold" FontSize="14" Margin="3,0,0,0"
                               Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 工具栏（居中，统一高度 34） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Button x:Name="BtnNew" Style="{StaticResource ToolbarButton}" Click="BtnNew_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="LblNew" Text="新建" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnOpen" Style="{StaticResource ToolbarButton}" Click="BtnOpen_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="LblOpen" Text="打开" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSave" Style="{StaticResource ToolbarButton}" Click="BtnSave_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="LblSave" Text="保存" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="10,0" />
                    <Button x:Name="BtnRun" Style="{StaticResource PrimaryButton}" Click="BtnRun_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="LblRun" Text="连续运行" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnRunOnce" Style="{StaticResource ToolbarButton}" Click="BtnRunOnce_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="LblRunOnce" Text="运行一次" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnStop" Style="{StaticResource ToolbarButton}" IsEnabled="False"
                            Click="BtnStop_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="LblStop" Text="停止" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="10,0" />
                    <Button x:Name="BtnFit" Style="{StaticResource ToolbarButton}" Click="BtnFit_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="LblFit" Text="适应" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnActual" Style="{StaticResource ToolbarButton}" Click="BtnActual_Click">
                        <TextBlock x:Name="LblActual" Text="1:1" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>

                <!-- 右侧：状态 + 语言切换（规整为一组） -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,18,0">
                    <TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis" MaxWidth="320" />
                    <Border Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="12,0" />
                    <!-- 语言分段拨动开关：中 / EN -->
                    <Border x:Name="LangToggle" Width="92" Height="30" VerticalAlignment="Center"
                            Background="{StaticResource SurfaceMutedBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="LangZhBtn" Grid.Column="0" Content="中" Tag="zh"
                                    Style="{StaticResource SegToggleBtn}" Click="LangToggle_Click" />
                            <Button x:Name="LangEnBtn" Grid.Column="1" Content="EN" Tag="en"
                                    Style="{StaticResource SegToggleBtn}" Click="LangToggle_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             底部日志面板
             ============================================================ -->
        <Border DockPanel.Dock="Bottom" Height="140"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceMutedBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,4">
                    <DockPanel>
                        <TextBlock x:Name="LogTitleText" Text="日志" FontWeight="SemiBold" FontSize="12"
                                   VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <TextBlock x:Name="LogCountText" Text="0 条"
                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            <Button x:Name="BtnClearLog" Content="清空" Padding="8,2"
                                    Margin="0,0,4,0" Click="BtnClearLog_Click" />
                            <CheckBox x:Name="AutoScrollCheck" Content="自动滚动"
                                      IsChecked="True" VerticalAlignment="Center"
                                      Margin="8,0,0,0" FontSize="11" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ListBox x:Name="LogList" BorderThickness="0" Background="#FAFAFA"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemsSource="{Binding Entries, Source={x:Static execution:Logger.Instance}}"
                         FontFamily="Consolas, Cascadia Mono, monospace" FontSize="11">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type execution:LogEntry}">
                            <TextBlock Text="{Binding DisplayText}"
                                       Foreground="{Binding LevelBrush}"
                                       TextOptions.TextFormattingMode="Display" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================================================
             中间区域：Grid 三列布局
             列0=节点库(200px)  列1=画布(占剩余一半)  列2=图像窗口(占剩余一半)
             图像窗口始终占 UI 的一半
             ============================================================ -->
        <Grid Background="{StaticResource SurfaceMutedBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 列0：节点库 -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock x:Name="LibTitleText" DockPanel.Dock="Top" Text="节点库" Style="{StaticResource HeaderLabel}"
                               Margin="14,12,14,8" />
                    <TextBox x:Name="NodeSearchBox" DockPanel.Dock="Top"
                             Margin="10,0,10,6" Padding="6,3"
                             TextChanged="NodeSearchBox_TextChanged"
                             ToolTip="输入关键字过滤节点（名称/分类）" />
                    <ListBox x:Name="NodeLibraryList"
                             BorderThickness="0" Background="Transparent"
                             Padding="6,0,6,8"
                             SelectionMode="Single"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseLeftButtonDown="NodeLibraryList_PreviewMouseLeftButtonDown">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <Expander IsExpanded="True" Margin="2,4,2,0"
                                                              BorderBrush="{StaticResource BorderBrush}"
                                                              BorderThickness="0,0,0,1">
                                                        <Expander.Header>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold" FontSize="12"
                                                                       Foreground="{StaticResource TextMainBrush}" />
                                                        </Expander.Header>
                                                        <ItemsPresenter Margin="0,2"/>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemBorder" Padding="8,6" CornerRadius="5"
                                        Background="Transparent" Margin="0,1">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="4" CornerRadius="2"
                                                Background="{Binding CategoryBrush}"
                                                Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding DisplayNameLocalized}" FontWeight="SemiBold"
                                                   FontSize="13" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#F5F3FF" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 列1：画布 -->
            <controls:NodeCanvas Grid.Column="1" x:Name="CanvasHost" ClipToBounds="True" />

            <!-- 列2：图像查看窗口（始终占 UI 的一半） -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <controls:ImageWindow x:Name="ImageHost" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
