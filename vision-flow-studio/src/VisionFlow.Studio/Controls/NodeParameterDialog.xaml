<Window x:Class="VisionFlow.Studio.Controls.NodeParameterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="节点参数设置" Height="600" Width="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 节点标题 -->
        <TextBlock x:Name="NodeTitleText" Grid.Row="0"
                   FontSize="16" FontWeight="SemiBold"
                   Text="{Binding DisplayName}"/>
        <TextBlock x:Name="NodeCategoryText" Grid.Row="1"
                   FontSize="11" Margin="0,2,0,12"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Text="{Binding Category, StringFormat='类别：{0}'}"/>

        <!-- 参数列表（运行时填充） -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ParamPanel" Margin="0,0,0,8"/>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="确定" Width="80" Padding="0,6"
                    IsDefault="True" Click="OK_Click"/>
            <Button Content="取消" Width="80" Padding="0,6"
                    Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
