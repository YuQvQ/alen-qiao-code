<UserControl x:Class="VisionFlow.Studio.Controls.NodeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VisionFlow.Studio.Controls"
             xmlns:models="clr-namespace:VisionFlow.Studio.Models"
             x:Name="Root"
             Width="240">
    <Border BorderThickness="1" CornerRadius="6"
            BorderBrush="{Binding NodeBorderBrush,
                        RelativeSource={RelativeSource AncestorType=UserControl}}"
            Background="{StaticResource SurfaceBrush}">
        <!-- 卡片阴影（轻量） -->
        <Border.Effect>
            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.18" Color="#000000" />
        </Border.Effect>

        <DockPanel>
            <!-- 标题栏：正常=类别画刷，错误态=ErrorBrush（强制红色） -->
            <Border DockPanel.Dock="Top" CornerRadius="6,6,0,0" Padding="10,6"
                    Background="{Binding HeaderBrush,
                                RelativeSource={RelativeSource AncestorType=UserControl}}">
                <DockPanel>
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                               FontSize="13" Foreground="White"
                               VerticalAlignment="Center" />
                    <!-- 错误标识：HasError=true 时显示，ToolTip 给完整错误信息 -->
                    <TextBlock DockPanel.Dock="Right" Text="⚠" FontSize="14"
                               Foreground="#FFEE00" Margin="6,0,6,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsError,
                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                            Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                               ToolTip="{Binding ErrorToolTip,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <!-- 手动运行本节点按钮 -->
                    <Button DockPanel.Dock="Right" Content="▶"
                            Width="22" Height="20" Padding="0"
                            Background="Transparent" Foreground="White"
                            BorderBrush="#80FFFFFF" BorderThickness="1"
                            Margin="6,0,0,0" Cursor="Hand"
                            ToolTip="运行此节点（含上游依赖）"
                            Click="RunButton_Click" />
                    <!-- 使用说明按钮 -->
                    <Button DockPanel.Dock="Right" Content="?"
                            Width="22" Height="20" Padding="0"
                            Background="Transparent" Foreground="White"
                            BorderBrush="#80FFFFFF" BorderThickness="1"
                            Margin="6,0,0,0" Cursor="Hand" FontWeight="Bold"
                            ToolTip="使用说明（输入/输出/参数）"
                            Click="HelpButton_Click" />
                </DockPanel>
            </Border>

            <!-- 端口区：左输入 / 右输出 -->
            <Grid Margin="8,4,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 输入端口列表 -->
                <ItemsControl Grid.Column="0" ItemsSource="{Binding Inputs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Port}">
                            <DockPanel Margin="0,2" ToolTip="{Binding ToolTipText}">
                                <Ellipse Width="10" Height="10"
                                         Fill="{Binding Type.ColorBrushKey,
                                                    Converter={x:Static local:BrushKeyConverter.Instance},
                                                    ConverterParameter={x:Reference Root}}"
                                         Stroke="White" StrokeThickness="1"
                                         MouseLeftButtonDown="Port_MouseDown"
                                         Cursor="Cross" />
                                <TextBlock FontSize="11"
                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                    <Run Text=" " />
                                    <Run Text="{Binding Type.Name, Mode=OneWay}" FontSize="9" Foreground="#888888"/>
                                    <Run Text="{Binding Required, Mode=OneWay, StringFormat=' [{0}]'}" FontSize="9" Foreground="#888888"/>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 输出端口列表 -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Outputs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Port}">
                            <DockPanel Margin="0,2" ToolTip="{Binding ToolTipText}">
                                <Ellipse DockPanel.Dock="Right" Width="10" Height="10"
                                         Fill="{Binding Type.ColorBrushKey,
                                                    Converter={x:Static local:BrushKeyConverter.Instance},
                                                    ConverterParameter={x:Reference Root}}"
                                         Stroke="White" StrokeThickness="1"
                                         MouseLeftButtonDown="Port_MouseDown"
                                         Cursor="Cross" />
                                <TextBlock FontSize="11"
                                           Margin="0,0,6,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextAlignment="Right"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                    <Run Text=" " />
                                    <Run Text="{Binding Type.Name, Mode=OneWay}" FontSize="9" Foreground="#888888"/>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
