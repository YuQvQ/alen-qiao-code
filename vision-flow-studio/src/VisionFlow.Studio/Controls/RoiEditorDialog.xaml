<Window x:Class="VisionFlow.Studio.Controls.RoiEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="框选模板 ROI" Height="640" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceMutedBrush}">
    <DockPanel Margin="10">
        <!-- 顶部说明 -->
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
                   Text="在图像上拖拽鼠标框选模板区域，滚轮缩放，中键平移，右键重置"
                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" />

        <!-- 底部按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock x:Name="HintText" Text="尚未框选" Margin="0,0,12,0"
                       VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
            <Button x:Name="BtnOk" Content="确定" Padding="14,4" Margin="4,0" IsEnabled="False"
                    Click="BtnOk_Click" />
            <Button Content="取消" Padding="14,4" Margin="4,0" Click="BtnCancel_Click" />
        </StackPanel>

        <!-- 图像 + ROI 画布（叠加） -->
        <Canvas x:Name="ImageGrid" Background="#1E1E1E"
                MouseDown="OnMouseDown" MouseMove="OnMouseMove" MouseUp="OnMouseUp"
                MouseWheel="OnMouseWheel"
                ClipToBounds="True">
            <Image x:Name="ImageView" Stretch="Fill" />
            <Canvas x:Name="RoiCanvas" />
        </Canvas>
    </DockPanel>
</Window>
